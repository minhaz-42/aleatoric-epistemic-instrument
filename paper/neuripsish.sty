% neuripsish.sty -- a stand-in for the official NeurIPS style file.
%
% The official neurips_20XX.sty is not redistributable and was not available on the machine this
% paper was built on, so this reproduces the layout it produces: 10pt Times on a 5.5in x 9in text
% block, bold run-in section heads, a centred title block, and numbered references. It is close
% enough to judge length and layout against a page limit, and it is NOT the official file.
%
% To submit: drop the venue's own style file into paper/, and in main.tex replace
%     \usepackage{neuripsish}
% with
%     \usepackage[final]{neurips_2026}      % or \usepackage{neurips_2026} for the anonymous form
% Nothing else in main.tex depends on this file.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neuripsish}[2026/09/22 NeurIPS-like layout, unofficial]

\RequirePackage[letterpaper, textwidth=5.5in, textheight=9in, centering]{geometry}
\RequirePackage{mathptmx}
\RequirePackage[T1]{fontenc}
\RequirePackage{titlesec}
\RequirePackage{caption}

\renewcommand{\normalsize}{\fontsize{10}{12}\selectfont}
\normalsize
\setlength{\parskip}{0pt}
\setlength{\parindent}{1em}

\titleformat{\section}{\bfseries\fontsize{12}{14}\selectfont}{\thesection}{0.6em}{}
\titleformat{\subsection}{\bfseries\fontsize{10}{12}\selectfont}{\thesubsection}{0.6em}{}
\titlespacing{\section}{0pt}{1.4ex plus .3ex minus .2ex}{0.7ex plus .2ex}
\titlespacing{\subsection}{0pt}{1.1ex plus .3ex minus .2ex}{0.5ex plus .2ex}

\captionsetup{font=small, labelfont=bf, skip=4pt}

% the title block: centred, large bold title, then authors, then a rule
\renewcommand{\maketitle}{%
  \begin{center}
    {\bfseries\fontsize{14}{17}\selectfont \@title\par}
    \vskip 1.2em
    {\normalsize \@author\par}
  \end{center}
  \vskip 0.8em
}

% abstract: indented block with a bold centred head, as NeurIPS sets it
\renewenvironment{abstract}{%
  \begin{center}{\bfseries\fontsize{10}{12}\selectfont Abstract}\end{center}
  \vspace{-0.4em}
  \begin{list}{}{\setlength{\leftmargin}{0.5in}\setlength{\rightmargin}{0.5in}}\item[]%
  \small
}{%
  \end{list}\vskip 0.8em
}
